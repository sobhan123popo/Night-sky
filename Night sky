class Game(Base):
    def on_pre_enter(self):
        self.box.clear_widgets(); a=App.get_running_app(); q,ans=DATA[a.level][a.stage-1]; a.answer=ans; self.typed=''; self.buttons=[]
        b=btn('MENU',80,48,13); b.pos_hint={'right':.95,'top':.965}; b.bind(on_press=lambda x:setattr(a.sm,'current','menu')); self.box.add_widget(b)
        b=btn('RESTART',90,48,11); b.pos_hint={'x':.04,'top':.965}; b.bind(on_press=lambda x:self.reset()); self.box.add_widget(b)
        self.box.add_widget(self.txt(f'STAGE {a.stage}',19,size_hint=(1,None),height=dp(45),pos_hint={'center_x':.5,'top':.90}))
        ql=self.txt(q,20,size_hint=(.88,None),height=dp(160),pos_hint={'center_x':.5,'center_y':.70}); ql.halign='center'; ql.valign='middle'; ql.bind(size=lambda x,v:setattr(x,'text_size',v)); self.box.add_widget(ql)
        self.al=self.txt('—',29,size_hint=(.9,None),height=dp(55),pos_hint={'center_x':.5,'center_y':.51}); self.box.add_widget(self.al)
        # Answer letters + a few distractors. Every answer letter remains available.
        letters=list(ans)+random.sample('ABCDEFGHIJKLMNOPQRSTUVWXYZ',max(0,min(4,10-len(ans))))
        random.shuffle(letters)
        g=GridLayout(cols=5,spacing=dp(7),padding=dp(12),size_hint=(.92,.30),pos_hint={'center_x':.5,'y':.08})
        for ch in letters:
            b=btn(ch,58,50,18); b.bind(on_press=lambda x,ch=ch,button=b:self.add(ch,button)); self.buttons.append(b); g.add_widget(b)
        self.box.add_widget(g)
    def add(self,ch,button):
        a=App.get_running_app()
        if len(self.typed)>=len(a.answer): return
        self.typed+=ch; button.disabled=True; button.opacity=.35
        self.al.text=self.typed
        if self.typed==a.answer:
            if a.stage==a.progress[a.level] and a.stage<50: a.progress[a.level]+=1; a.save()
            a.sm.current='win'
        elif not a.answer.startswith(self.typed):
            self.al.text='TRY AGAIN'; self.typed=''
            for b in self.buttons: b.disabled=False; b.opacity=1
    def reset(self):
        self.typed=''; self.al.text='—'
        for b in getattr(self,'buttons',[]): b.disabled=False; b.opacity=1


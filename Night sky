def make_music_file():
    """Creates a small original looping melody automatically; no music download needed."""
    path=os.path.join(os.path.dirname(__file__) or '.', 'bla_theme.wav')
    if os.path.exists(path): return path
    sr=22050; bpm=92; beat=60.0/bpm
    # Original simple night-sky melody.
    notes=[220.0,261.63,329.63,293.66,246.94,196.0,220.0,329.63,
           392.0,329.63,293.66,261.63,220.0,246.94,293.66,220.0]
    total=int(sr*beat*2*len(notes)); data=[]
    for i in range(total):
        t=i/sr; idx=int(t/(beat*2)); local=t%(beat*2); f=notes[idx%len(notes)]
        env=min(1,local*8)*max(0,(beat*2-local)*2.2)
        tone=0.16*math.sin(2*math.pi*f*t)+0.055*math.sin(2*math.pi*f*2*t)
        # soft bass pulse
        bass=0.035*math.sin(2*math.pi*(f/2)*t)
        val=max(-1,min(1,(tone+bass)*env))
        data.append(struct.pack('<h',int(val*32767)))
    with wave.open(path,'wb') as w:
        w.setnchannels(1); w.setsampwidth(2); w.setframerate(sr); w.writeframes(b''.join(data))
    return path

class NightBG(FloatLayout):
    def __init__(self, **kw):
        super().__init__(**kw)
        with self.canvas.before:
            Color(0.008,0.015,0.045,1); self.base=Rectangle(pos=self.pos,size=self.size)
            Color(0.012,0.028,0.085,1); self.sky=Rectangle(pos=self.pos,size=self.size)
            Color(0.035,0.065,0.16,1); self.haze=Rectangle(pos=(self.x,self.y+self.height*.28),size=(self.width,self.height*.22))
        self.stars=[]
        with self.canvas:
            random.seed(42)
            for _ in range(55):
                x=random.random(); y=.10+random.random()*.84; r=random.choice([.8,1,1,1.3,1.7])
                Color(0.75+random.random()*.25,0.78+random.random()*.22,0.9+random.random()*.1,1)
                self.stars.append(Ellipse(pos=(0,0),size=(dp(r),dp(r))))
        self.bind(pos=self._sync,size=self._sync)
        self._sync()
    def _sync(self,*a):
        self.base.pos=self.pos; self.base.size=self.size
        self.sky.pos=self.pos; self.sky.size=self.size
        self.haze.pos=(self.x,self.y+self.height*.28); self.haze.size=(self.width,self.height*.22)
        random.seed(42)
        for e in self.stars:
            e.pos=(self.x+random.random()*self.width,
                   self.y+(0.10+random.random()*.84)*self.height)


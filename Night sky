class PuzzleApp(App):
    def build(self):
        self.level=0; self.stage=1; self.answer=''; self.progress=[5,5,5,5]
        self.music_on=True; self.volume=3; self.sound=None
        self.store=JsonStore('puzzle_progress.json')
        if self.store.exists('progress'): self.progress=self.store.get('progress')['data']
        if self.store.exists('settings'):
            st=self.store.get('settings'); self.music_on=st.get('music',True); self.volume=st.get('volume',3)
        try:
            self.sound=SoundLoader.load(make_music_file())
            if self.sound:
                self.sound.loop=True; self.apply_volume();
                if self.music_on: self.sound.play()
        except Exception:
            self.sound=None
        self.sm=ScreenManager()
        for C,n in [(Home,'home'),(Settings,'settings'),(Levels,'levels'),(Stages,'stages'),(Game,'game'),(Menu,'menu'),(Win,'win')]: self.sm.add_widget(C(name=n))
        return self.sm
    def apply_volume(self):
        if self.sound: self.sound.volume=self.volume/5.0
    def set_music(self,on):
        self.music_on=on
        if self.sound:
            if on: self.sound.play()
            else: self.sound.stop()
        self.save_settings()
    def save_settings(self): self.store.put('settings',music=self.music_on,volume=self.volume)
    def save(self): self.store.put('progress',data=self.progress); self.save_settings()

if __name__=='__main__': PuzzleApp().run()
